{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=AIImageAPI;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "Database": {
    "AutoMigrate": true
  },
